#!/usr/bin/env python3
"""Interactive CD auto-ripper: watches the drive, scrapes metadata on
insert, lets you set a track priority order, then rips via abcde.

Replaces the old udev/systemd auto-trigger (disabled by install.sh) as the
thing that actually starts a rip - launch this once and it handles every
disc you insert until you quit it.
"""
import fcntl
import glob
import json
import os
import re
import select
import shutil
import subprocess
import sys
import time
import urllib.error

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import spinitron
import metadata_lookup
import catalog_writeback
import label_render
import fake_drive
import photo_capture
import ocr_metadata


def _load_secrets_env(path):
    """KEY=VALUE lines from a gitignored local file (never committed) into
    os.environ, without overriding a real env var already set. Lets
    secrets like ACOUSTID_API_KEY persist across shells without editing
    a shell profile."""
    if not os.path.isfile(path):
        return
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, val = line.partition("=")
            os.environ.setdefault(key.strip(), val.strip())


_load_secrets_env(os.path.join(os.path.expanduser("~"), ".config", "wtul", "secrets.env"))

DEV = f"/dev/{sys.argv[1]}" if len(sys.argv) > 1 else "/dev/sr0"
DEVNAME = os.path.basename(DEV)
HOME = os.path.expanduser("~")
# Rips land directly in a dated mix folder (2026-07-24: what gets ripped on a
# given day IS that day's mix, no separate curation-into-a-mix-folder step -
# see FOCUS.md's "Branch health"/"Current focus" #6 for the ~/Music/ripped -> here
# migration note). RIPDIR is always *today's* folder - the one abcde.conf's
# OUTPUTDIR/WAVOUTPUTDIR must also point at, since album_dir_path() below has
# to mirror wherever abcde actually writes. Historical searches (fix_by_discid,
# history()) glob across MIXES_ROOT/*/ instead of just RIPDIR, since a disc
# fixed today may have been ripped on an earlier show night.
MIXES_ROOT = os.path.join(HOME, "Music", "mixes")

# Rehearsal mode (WTUL_SIMULATE_DRIVE, see lib/fake_drive.py): no disc, no
# drive, and - critically - a sandboxed MIXES_ROOT. Everything downstream
# (RIPDIR, LOGDIR, album_dir_path, history(), fix_by_discid) is derived from
# this one value, so redirecting it here is the whole containment: a
# rehearsal physically cannot write a fake mp3 into the real mix folder that
# gets burned to a CD, and its logs can't pollute the real rip history.
SIMULATING = bool(os.environ.get(fake_drive.ENV_SPEC, "").strip())
if SIMULATING:
    MIXES_ROOT = fake_drive.sandbox_root()
# The FakeDrive itself is built later, by init_simulation(), because it needs
# album_dir_path() - defined further down - as its single source of truth for
# where a track lands. None here means "not rehearsing"; every hardware call
# site checks it.
SIM = None

RIPDIR = os.path.join(MIXES_ROOT, time.strftime("%Y-%m-%d"))
LOGDIR = os.path.join(MIXES_ROOT, ".logs")
# Rip logs from before the 2026-07-24 ripped->mixes migration stay at the
# old location, untouched (see FOCUS.md #6). New logs never land there, but
# the speed report reads it too - otherwise every rip before the migration
# is invisible to exactly the kind of over-time comparison the report is for.
LEGACY_LOGDIR = os.path.join(HOME, "Music", "ripped", ".logs")
# A separate lockfile: a rehearsal must not look like a real rip in progress
# to a concurrently-running real wtul-rip, nor be blocked by one.
LOCKFILE = f"/tmp/cd-autorip{'-sim' if SIMULATING else ''}-{DEVNAME}.lock"
NOEJECT_CONF = os.path.join(HOME, ".abcde-noeject.conf")
ACOUSTID_API_KEY = os.environ.get("ACOUSTID_API_KEY", "").strip()
DISCOGS_TOKEN = os.environ.get("DISCOGS_TOKEN", "").strip()
CATALOG_WRITEBACK_URL = os.environ.get("CATALOG_WRITEBACK_URL", "").strip()
# Rehearsals never POST to the real rotation catalog (see rip_session). This
# escape hatch is for the rehearsal test suite only, which injects a fake
# write_row - it is deliberately not documented as a user-facing knob.
SIMULATE_ALLOW_CATALOG = bool(
    os.environ.get("WTUL_SIMULATE_ALLOW_CATALOG", "").strip())
PHOTO_CAPTURE_URL = os.environ.get("PHOTO_CAPTURE_URL", "").strip()
PENDING_PHOTOS_FILE = os.path.join(RIPDIR, ".photo-pending.json")

PER_TRACK_TIMEOUT = 900       # 15 min/track cap - a bad drive can't hang forever
MAX_LOG_BYTES = 5_000_000     # matches the old wrapper's runaway-log cap
POLL_SECS = 2                 # how often we check the drive while idle
STALE_TEMPDIR_SECS = 6 * 3600 # abandoned rip scratch dirs older than this get pruned
EARCON_ENABLED = os.environ.get("WTUL_EARCON", "1").strip() != "0"


def earcon():
    """Terminal bell for a detection failure that might go unnoticed if
    no one's watching the screen. WTUL_EARCON=0 disables (e.g. headless/
    logged sessions where a stray \\a in the log is unwanted)."""
    if EARCON_ENABLED:
        sys.stdout.write("\a")
        sys.stdout.flush()


def _int_env(name, default):
    try:
        return int(os.environ.get(name) or default)
    except ValueError:
        return default


SPIN_POLL_SECS = _int_env("WTUL_SPIN_POLL_SECS", 60)

SLOW_SPEED_FRACTION = 0.5     # a track under this fraction of the overall median gets flagged as slow

# cdparanoia prints a progress table while reading; the 4th |-delimited
# column is a running extraction-speed multiplier, e.g. "|   21.912x|".
# It's a running average that converges over the track, so the last
# non-zero sample is the track's effective read speed.
SPEED_RE = re.compile(r"\|\s*([\d.]+)x\|")
# eyeD3/abcde prints the finished file size, e.g. ".../track6.mp3[ 3.68 MB ]".
SIZE_RE = re.compile(r"\.mp3\[\s*([\d.]+)\s*MB\s*\]")
# rip_track writes "=== track N ===" before each track and a one-line note after.
TRACK_MARK_RE = re.compile(r"^=== track (\d+) ===")
NOTE_RE = re.compile(r"^track (\d+) (ripped OK|failed|TIMED OUT|interrupted)")
NOTE_STATUS = {"ripped OK": "ok", "failed": "failed",
               "TIMED OUT": "timeout", "interrupted": "interrupted"}


def sh(cmd, timeout=None):
    """Run a command, return (returncode, combined stdout+stderr text).

    stdin is always /dev/null: abcde's -N flag doesn't suppress every
    interactive prompt (e.g. "Is the CD multi-artist?" on an unidentified
    disc still asks), and without this it reads from wtul-rip's own
    controlling terminal - silently eating keystrokes meant for our own
    prompts and blocking on prompts you'd never see coming.

    In rehearsal mode the simulated drive answers the hardware commands
    (udevadm/cdparanoia/abcde/eject) instead of running them; anything it
    doesn't recognise still runs for real, since a rehearsal has no reason
    to fake e.g. a Discogs lookup.
    """
    if SIM is not None and SIM.handles(cmd):
        return SIM.run(cmd)
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL, timeout=timeout, text=True)
        return p.returncode, p.stdout
    except subprocess.TimeoutExpired as e:
        out = e.output or ""
        return 124, out if isinstance(out, str) else out.decode(errors="replace")


def udev_props(dev):
    rc, out = sh(["udevadm", "info", "--query=property", f"--name={dev}"])
    props = {}
    for line in out.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            props[k] = v
    return props


def disc_audio_track_count(dev):
    props = udev_props(dev)
    if props.get("ID_CDROM_MEDIA") != "1":
        return 0
    return int(props.get("ID_CDROM_MEDIA_TRACK_COUNT_AUDIO", "0") or "0")


class Lock:
    def __init__(self, path):
        self.path = path
        self.fh = None

    def acquire(self):
        self.fh = open(self.path, "w")
        try:
            fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            self.fh.close()
            self.fh = None
            return False
        return True

    def release(self):
        if self.fh:
            fcntl.flock(self.fh, fcntl.LOCK_UN)
            self.fh.close()
            self.fh = None


def free_kb(path):
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize // 1024


def newest_abcde_tempdir():
    dirs = glob.glob(os.path.join(RIPDIR, "abcde.*"))
    dirs = [d for d in dirs if os.path.isdir(d)]
    if not dirs:
        return None
    return max(dirs, key=os.path.getmtime)


def find_cddbread(tempdir):
    """Locate the cddbread.N file abcde writes after a metadata scrape.

    N is the chosen match's 1-based index (e.g. cddbread.1 for the first/only
    MusicBrainz hit), not always 0 - a disc with exactly one match still
    landed on cddbread.1 in testing (2026-07-24, "Belong / October
    Language"), which a hardcoded ".0" silently missed, parsed as no fields
    at all, and aborted the rip despite a perfectly good scrape sitting
    right there. Only root-level files match (data-musicbrainz/cddbread.1
    is a separate copy abcde also writes, not the canonical one)."""
    candidates = sorted(glob.glob(os.path.join(tempdir, "cddbread.*")))
    candidates = [c for c in candidates if os.path.isfile(c)]
    return candidates[0] if candidates else None


def read_toc_discid(tempdir):
    """Fallback disc ID computed purely from the TOC (track offsets), not a
    CDDB/MusicBrainz match - abcde always writes this via cd-discid before
    even attempting a lookup, so it's available even when nothing matched.
    Returns (discid, track_count), or (None, 0) if even this is missing."""
    path = os.path.join(tempdir, "cddbdiscid")
    if not os.path.isfile(path):
        return None, 0
    with open(path, "r", errors="replace") as f:
        parts = f.read().split()
    if len(parts) < 2:
        return None, 0
    try:
        return parts[0], int(parts[1])
    except ValueError:
        return None, 0


def parse_cddb_metadata(tempdir):
    """Read the cddbread.N file abcde writes after a metadata scrape."""
    path = find_cddbread(tempdir)
    fields = {}
    if path and os.path.exists(path):
        with open(path, "r", errors="replace") as f:
            for line in f:
                line = line.rstrip("\n")
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    fields[k] = v

    discid = fields.get("DISCID", "")
    dtitle = fields.get("DTITLE", "Unknown Artist / Unknown Album")
    if " / " in dtitle:
        artist, album = dtitle.split(" / ", 1)
    else:
        artist, album = dtitle, ""
    titles = {}
    for k, v in fields.items():
        m = re.match(r"^TTITLE(\d+)$", k)
        if m:
            titles[int(m.group(1)) + 1] = v  # TTITLE0 -> track 1
    return discid, artist, album, titles


def write_cddbread(tempdir, artist, album, titles):
    """Rewrite the cddbread.N file with edited artist/album/track titles so
    the next per-track abcde invocation (which re-reads this file fresh)
    tags and names files with the correction instead of the original
    scrape. See find_cddbread for why N isn't always 0."""
    path = find_cddbread(tempdir)
    lines = []
    if path and os.path.exists(path):
        with open(path, "r", errors="replace") as f:
            lines = f.readlines()
    out = []
    for line in lines:
        if line.startswith("DTITLE="):
            out.append(f"DTITLE={artist} / {album}\n")
            continue
        m = re.match(r"^TTITLE(\d+)=", line)
        if m:
            idx = int(m.group(1))
            out.append(f"TTITLE{idx}={titles.get(idx + 1, '')}\n")
            continue
        out.append(line if line.endswith("\n") else line + "\n")
    with open(path, "w") as f:
        f.writelines(out)


def find_track_file(album_dir, track_num):
    if not os.path.isdir(album_dir):
        return None
    for name in os.listdir(album_dir):
        if re.match(rf"^0*{track_num}-.*\.mp3$", name, re.IGNORECASE):
            return os.path.join(album_dir, name)
    return None


def retag_mp3(path, artist=None, album=None, title=None):
    from mutagen.easyid3 import EasyID3
    tags = EasyID3(path)
    if artist is not None:
        tags["artist"] = artist
    if album is not None:
        tags["album"] = album
    if title is not None:
        tags["title"] = title
    tags.save()


def retag_ripped_tracks(ripped, old_artist, old_album, new_artist, new_album, discid):
    """Move + retag mp3s for tracks already ripped this session after a
    live artist=/album= correction, so a fix doesn't only apply going
    forward - it also repairs what the disc already produced."""
    if not ripped:
        return
    old_dir = album_dir_path(old_artist, old_album, discid)
    new_dir = album_dir_path(new_artist, new_album, discid)
    if old_dir == new_dir:
        for n, path in list(ripped.items()):
            retag_mp3(path, artist=new_artist, album=new_album)
        return
    os.makedirs(new_dir, exist_ok=True)
    for n, path in list(ripped.items()):
        if not os.path.exists(path):
            continue
        new_path = os.path.join(new_dir, os.path.basename(path))
        os.rename(path, new_path)
        retag_mp3(new_path, artist=new_artist, album=new_album)
        ripped[n] = new_path
    try:
        if not os.listdir(old_dir):
            os.rmdir(old_dir)
            parent = os.path.dirname(old_dir)
            if os.path.isdir(parent) and not os.listdir(parent):
                os.rmdir(parent)
    except OSError:
        pass


def apply_live_input(line, queue, tempdir, artist, album, titles, ripped, discid):
    """Parse one line of live user input typed while ripping is underway.
    Returns (artist, album, titles, control) - control is None, "stop"
    (q/!q: leave the rest of the queue unripped, disc stays for retry) or
    "eject" (e/!e: stop and eject now regardless of what's left). Mutates
    queue in place to reprioritize remaining tracks, and retags/moves any
    already-ripped tracks (in `ripped`) when artist/album changes.

    The !-prefixed forms only differ from the bare forms while a track is
    actively ripping (sh_live() kills it immediately instead of waiting
    for it to finish) - here, between tracks, there's nothing running to
    kill, so q/!q and e/!e are handled identically.
    """
    line = line.strip()
    if not line:
        return artist, album, titles, None

    low = line.lower()
    if low in ("q", "!q"):
        print("  -> stopping after this track, disc stays in the drive")
        return artist, album, titles, "stop"
    if low in ("e", "!e"):
        print("  -> stopping and ejecting now")
        return artist, album, titles, "eject"

    m = re.match(r"^(artist|album)\s*=\s*(.+)$", line, re.IGNORECASE)
    if m:
        key, val = m.group(1).lower(), m.group(2).strip()
        old_artist, old_album = artist, album
        if key == "artist":
            artist = val
        else:
            album = val
        write_cddbread(tempdir, artist, album, titles)
        try:
            retag_ripped_tracks(ripped, old_artist, old_album, artist, album, discid)
        except ImportError:
            print("  -> (mutagen not available, couldn't retag already-ripped tracks)")
        fixed = f", fixed {len(ripped)} already-ripped track(s)" if ripped else ""
        print(f"  -> {key} set to '{val}'{fixed}")
        return artist, album, titles, None

    m = re.match(r"^(\d+)\s*=\s*(.+)$", line)
    if m:
        n, val = int(m.group(1)), m.group(2).strip()
        titles[n] = val
        write_cddbread(tempdir, artist, album, titles)
        if n in ripped:
            try:
                retag_mp3(ripped[n], title=val)
                print(f"  -> track {n} title set to '{val}' (retagged)")
            except ImportError:
                print(f"  -> track {n} title set to '{val}' (mutagen unavailable, couldn't retag)")
        else:
            print(f"  -> track {n} title set to '{val}'")
        return artist, album, titles, None

    m = re.match(r"^only\s+(\d+(?:\s+\d+)*)$", line, re.IGNORECASE)
    if m:
        nums = [int(t) for t in m.group(1).split()]
        valid = [n for n in nums if n in titles]
        if valid:
            queue[:] = valid
            print(f"  -> ripping only: {', '.join(str(n) for n in queue)}")
        else:
            print("  -> none of those are valid track numbers, ignoring")
        return artist, album, titles, None

    if re.match(r"^\d+(\s+\d+)*$", line):
        nums = [int(t) for t in line.split()]
        front = [n for n in nums if n in queue]
        if front:
            rest = [n for n in queue if n not in front]
            queue[:] = front + rest
            print(f"  -> priority updated, remaining order: {', '.join(str(n) for n in queue)}")
        else:
            print("  -> none of those track numbers are still remaining, ignoring")
        return artist, album, titles, None

    print(f"  -> didn't understand '{line}', ignoring")
    return artist, album, titles, None


def musicbrainz_pick(query):
    """Interactive picker over a MusicBrainz free-text release search - the
    third identification fallback (after AcoustID and Discogs, ROADMAP #2)
    for a disc neither service could match, and the only one needing no
    key. Returns (artist, album) for the row the user picked, or None if
    the search came back empty or the user skipped - the caller re-offers
    a pick as an editable suggestion, never applies it blind."""
    if not query:
        print("  usage: ? <search text>   (artist/album words, e.g. read "
              "off the cover)")
        return None
    print(f"  Searching MusicBrainz for '{query}'...")
    results = metadata_lookup.musicbrainz_search_release(query)
    if not results:
        print("  No MusicBrainz match (or the search failed) - try different words.")
        return None
    for i, r in enumerate(results, 1):
        year = f" ({r['year']})" if r.get("year") else ""
        print(f"    {i}. {r['artist']} - {r['album']}{year}")
    raw = input("  Use which one? (number, blank to skip): ").strip()
    if raw.isdigit() and 1 <= int(raw) <= len(results):
        r = results[int(raw) - 1]
        return r["artist"], r["album"]
    return None


def fix_by_discid(discid):
    """Fix an already-completed unidentified disc after the fact - unlike
    live in-session edits, this works even after wtul-rip has moved on,
    because the disc ID is baked into the "Unknown Album (discid)" folder
    name itself."""
    matches = glob.glob(os.path.join(MIXES_ROOT, "*", "*", f"*({discid})"))
    if not matches:
        print(f"No ripped album found for disc ID '{discid}'.")
        return
    old_dir = matches[0]
    print(f"Found: {old_dir}")
    # Fix stays in the mix folder it was actually ripped into (not today's),
    # so a disc fixed days after a show still ends up on that show's mix.
    day_dir = os.path.dirname(os.path.dirname(old_dir))

    suggested_artist, suggested_album = None, None
    if ACOUSTID_API_KEY:
        track_paths = sorted(
            os.path.join(old_dir, n) for n in os.listdir(old_dir) if n.lower().endswith(".mp3")
        )
        if track_paths:
            print("Trying AcoustID (+ Discogs fallback) on the ripped audio...")
            suggested_artist, suggested_album = metadata_lookup.resolve_disc_metadata(
                track_paths, acoustid_key=ACOUSTID_API_KEY, discogs_token=DISCOGS_TOKEN or None)
            if suggested_artist or suggested_album:
                print(f"  -> suggestion: {suggested_artist or '?'} - {suggested_album or '?'} "
                      f"(unverified match, confirm or edit below)")
            else:
                print("  -> no confident match, falling back to manual entry.")

    if not suggested_artist and not suggested_album:
        ocr_lines = ocr_metadata.ocr_cover_candidates(old_dir)
        if ocr_lines:
            print("  -> OCR text from this disc's cover photo (unverified, "
                  "type in what you read below - not auto-filled):")
            for line in ocr_lines:
                print(f"       {line}")
        print("  -> tip: '? <text>' at the artist prompt searches MusicBrainz "
              "(free-text, no key) - e.g. words read off the cover.")

    # The artist prompt doubles as a search box: '? <text>' runs a
    # MusicBrainz free-text release search and, if the user picks a
    # result, re-offers it as the suggestion - still confirm/edit like
    # every other suggestion source, never applied blind.
    while True:
        artist_prompt = f"New artist (blank to use suggestion '{suggested_artist}'" \
            if suggested_artist else "New artist (blank to keep 'Unknown Artist'"
        raw_artist = input(f"{artist_prompt}, '? <text>' to search): ").strip()
        if raw_artist.startswith("?"):
            picked = musicbrainz_pick(raw_artist[1:].strip())
            if picked:
                suggested_artist, suggested_album = picked
                print(f"  -> suggestion now: {suggested_artist} - {suggested_album} "
                      f"(blank at the prompts accepts it)")
            continue
        break
    new_artist = raw_artist or suggested_artist or "Unknown Artist"
    album_prompt = f"New album (blank to use suggestion '{suggested_album}'" \
        if suggested_album else "New album (blank to keep current"
    new_album = input(f"{album_prompt}): ").strip() or suggested_album
    if not new_album:
        print("No album given, leaving as-is.")
        return
    # Same munging as album_dir_path(): a fixed disc has to land in the
    # folder abcde itself would have written, or re-inserting that disc
    # later won't see it as already-ripped. (Typed by hand here rather than
    # scraped, so ":"/"?"/quotes are, if anything, more likely.)
    new_dir = os.path.join(day_dir, munge_filename(new_artist), munge_filename(new_album))
    os.makedirs(new_dir, exist_ok=True)
    try:
        from mutagen.easyid3 import EasyID3
    except ImportError:
        print("mutagen not available - can't retag.")
        return
    moved = 0
    for name in os.listdir(old_dir):
        if not name.lower().endswith(".mp3"):
            continue
        old_path = os.path.join(old_dir, name)
        new_path = os.path.join(new_dir, name)
        os.rename(old_path, new_path)
        retag_mp3(new_path, artist=new_artist, album=new_album)
        moved += 1
    # The .discid marker has to follow the music: left behind, it makes
    # this dir un-removable below AND leaves find_prior_rip() matching a
    # dir with no mp3s in it, so a later re-insert of this disc would
    # "already ripped" against nothing instead of the corrected folder.
    old_marker = os.path.join(old_dir, ".discid")
    if os.path.exists(old_marker):
        try:
            os.remove(old_marker)
        except OSError:
            pass
        write_discid_marker(new_dir, discid)
    try:
        if not os.listdir(old_dir):
            os.rmdir(old_dir)
            parent = os.path.dirname(old_dir)
            if os.path.isdir(parent) and not os.listdir(parent):
                os.rmdir(parent)
    except OSError:
        pass
    print(f"Moved and retagged {moved} track(s) to {new_dir}")


def track_durations(dev):
    rc, out = sh(["cdparanoia", "-Q", "-d", dev], timeout=30)
    durations = {}
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\.\s+\d+\s+\[(\d+:\d+\.\d+)\]", line)
        if m:
            durations[int(m.group(1))] = m.group(2).rsplit(".", 1)[0]
    return durations


def existing_track_numbers(album_dir):
    """Track numbers that already have a ripped mp3 in album_dir."""
    got = set()
    if os.path.isdir(album_dir):
        for name in os.listdir(album_dir):
            m = re.match(r"^0*(\d+)-", name)
            if m and name.lower().endswith(".mp3"):
                got.add(int(m.group(1)))
    return got


def munge_filename(text):
    """Python mirror of `mungefilename()` in abcde.conf.

        mungefilename () { echo "$@" | sed s,:,-,g | tr -d \\'\\"\\?\\[:cntrl:\\] ; }

    abcde runs every path component of OUTPUTFORMAT (ARTISTFILE, ALBUMFILE,
    TRACKFILE) through that before writing, so anything here that predicts
    where a file landed has to apply the same rule or it predicts a folder
    that does not exist. Deliberately does NOT touch "/": abcde's version
    doesn't either, so an artist like "AC/DC" nests a directory in both -
    mirroring the real behaviour matters more than the tidier one.

    `tests/test_album_dir_munge.py` checks this against the shell function
    in abcde.conf by actually running it, so the two can't silently drift.
    """
    text = str(text).replace(":", "-")
    return "".join(c for c in text if c not in "'\"?" and ord(c) >= 32 and ord(c) != 127)


def find_prior_rip(discid, exclude_dir=None):
    """Most recently-modified already-ripped album dir carrying a `.discid`
    marker matching this disc's TOC discid, else None. TOC discid (not an
    audio fingerprint) is the identity check here: it's already computed for
    free by every rip session, per the stopgap this was scoped from in
    QUESTIONS.md - a real audio-fingerprint-based cache is future work if
    this proves too weak across different pressings of the same release."""
    candidates = []
    for marker in glob.glob(os.path.join(MIXES_ROOT, "*", "*", "*", ".discid")):
        album_dir = os.path.dirname(marker)
        if exclude_dir and os.path.abspath(album_dir) == os.path.abspath(exclude_dir):
            continue
        try:
            with open(marker) as f:
                found = f.read().strip()
        except OSError:
            continue
        if found == discid:
            candidates.append(album_dir)
    if not candidates:
        return None
    candidates.sort(key=os.path.getmtime, reverse=True)
    return candidates[0]


def symlink_prior_rip(prior_dir, album_dir):
    """Symlink every mp3 in prior_dir into album_dir (skipping any that
    already exist there) instead of re-ripping a disc already captured on an
    earlier week's mix. Returns how many were linked."""
    os.makedirs(album_dir, exist_ok=True)
    linked = 0
    for name in os.listdir(prior_dir):
        if not name.lower().endswith(".mp3"):
            continue
        dst = os.path.join(album_dir, name)
        if os.path.lexists(dst):
            continue
        os.symlink(os.path.join(prior_dir, name), dst)
        linked += 1
    return linked


def write_discid_marker(album_dir, discid):
    """Records this album dir's TOC discid so a future rip of the same disc
    (e.g. next week's show) can be recognized by find_prior_rip() and
    symlinked instead of re-ripped from scratch."""
    try:
        with open(os.path.join(album_dir, ".discid"), "w") as f:
            f.write(discid + "\n")
    except OSError:
        pass


def album_dir_path(artist, album, discid):
    """Where abcde will actually place this disc's files. Must mirror the
    OUTPUTFORMAT disambiguation in abcde.conf: unidentified discs all share
    the literal "Unknown Album" title, so without the disc ID suffix every
    unidentified disc would resolve to the same folder and each would look
    like the others' tracks were already ripped.

    It must mirror abcde.conf's `mungefilename()` too (2026-07-25): this
    used to pass artist/album through untouched, so any disc whose metadata
    contained an apostrophe, a quote, a "?" or a ":" - "It's Alive",
    "Songs: Ohia" - resolved to a folder abcde had never written to. That
    silently broke three things at once, all of which look like the feature
    just not working rather than like a path bug: resume-skip on reinsert
    re-ripped every track, `find_track_file()` never populated `ripped` so
    live `artist=`/`album=`/`N=Title` edits couldn't retag what was already
    on disk, and `retag_ripped_tracks()` moved files into a second wrong
    folder. Note the suffix is keyed on the RAW album name and appended
    AFTER munging, because that's the order OUTPUTFORMAT does it in
    ("${ALBUMFILE}$([ "$DALBUM" = "Unknown Album" ] && ...)").
    """
    artist_raw = artist.strip() or "Unknown Artist"
    album_raw = album.strip() or "Unknown Album"
    album_clean = munge_filename(album_raw)
    if album_raw == "Unknown Album":
        album_clean = f"{album_clean} ({discid})"
    return os.path.join(RIPDIR, munge_filename(artist_raw), album_clean)


def print_tracklist(track_nums, titles, durations, already_done):
    print()
    for n in track_nums:
        tag = " (done)" if n in already_done else ""
        dur = durations.get(n, "?:??")
        print(f"  {n:2d}. {titles.get(n, f'Track {n}'):40s} {dur:>6s}{tag}")
    print()


def sh_live(cmd, logfile):
    """Like sh(), but streams the subprocess's output line-by-line to the
    terminal as it happens (so you can watch a track actually rip/encode)
    while also appending it to logfile, capped at MAX_LOG_BYTES total same
    as before.

    Concurrently watches stdin while the track runs: '!q'/'!e' kill the
    subprocess immediately (a typed equivalent of Ctrl+C, optionally
    followed by ejecting) instead of waiting for the track to finish.
    Any other line typed during the track is stashed in `pending` and
    returned for the normal between-track handling in rip_session(),
    since it's not urgent enough to interrupt anything.

    Returns (returncode, saw_error, urgent, pending, last_speed) - urgent is
    None, "q" or "e"; pending is a list of other lines typed meanwhile;
    last_speed is the final non-zero cdparanoia extraction-speed multiplier
    seen this run (float), or None if the output carried no speed samples.

    No explicit process timeout here: every real caller's cmd is already
    wrapped in the external `timeout` utility, which enforces the real
    limit by killing the child - that just shows up here as proc.stdout
    hitting EOF like any other process exit.
    """
    if SIM is not None and SIM.handles(cmd):
        return _sh_live_simulated(cmd, logfile)
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, text=True, bufsize=1)
    saw_error = False
    urgent = None
    pending = []
    last_speed = None
    written = os.path.getsize(logfile) if os.path.exists(logfile) else 0
    with open(logfile, "a") as lf:
        while True:
            rlist, _, _ = select.select([proc.stdout, sys.stdin], [], [])
            if proc.stdout in rlist:
                line = proc.stdout.readline()
                if line:
                    print(f"    {line.rstrip()}")
                    if "[ERROR]" in line:
                        saw_error = True
                    sm = None
                    for sm in SPEED_RE.finditer(line):
                        pass
                    if sm and float(sm.group(1)) > 0:
                        last_speed = float(sm.group(1))
                    if written < MAX_LOG_BYTES:
                        written += lf.write(line)
                elif proc.poll() is not None:
                    break
            if sys.stdin in rlist:
                cmdline = sys.stdin.readline()
                stripped = cmdline.strip().lower()
                if stripped in ("!q", "!e"):
                    urgent = stripped[1]
                    proc.terminate()
                    try:
                        proc.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                    break
                elif cmdline.strip():
                    pending.append(cmdline)
    return proc.wait(), saw_error, urgent, pending, last_speed


def _sh_live_simulated(cmd, logfile):
    """sh_live()'s rehearsal twin: replay the simulator's lines with the same
    printing, [ERROR] detection, log-capping and live-stdin handling, so the
    session logic under test is identical either way.

    stdin is still watched (non-blocking, between lines rather than via
    select on a real pipe) because rehearsing the live `artist=`/`5 2`/`!q`
    commands is one of the main things this mode is for.
    """
    rc, lines = SIM.stream(cmd)
    saw_error = False
    urgent = None
    pending = []
    last_speed = None
    written = os.path.getsize(logfile) if os.path.exists(logfile) else 0
    with open(logfile, "a") as lf:
        for line in lines:
            print(f"    {line}")
            if "[ERROR]" in line:
                saw_error = True
            sm = None
            for sm in SPEED_RE.finditer(line):
                pass
            if sm and float(sm.group(1)) > 0:
                last_speed = float(sm.group(1))
            if written < MAX_LOG_BYTES:
                written += lf.write(line + "\n")
            r, _, _ = select.select([sys.stdin], [], [], 0)
            if not r:
                continue
            cmdline = sys.stdin.readline()
            stripped = cmdline.strip().lower()
            if stripped in ("!q", "!e"):
                urgent = stripped[1]
                break
            elif cmdline.strip():
                pending.append(cmdline)
    return rc, saw_error, urgent, pending, last_speed


def init_simulation():
    """Build the simulated drive if WTUL_SIMULATE_DRIVE is set.

    Loud on a bad spec and never falls back to the real drive: silently
    ripping a real disc when a rehearsal was asked for (or the reverse) is
    the one failure mode here worth aborting over.
    """
    global SIM
    if not SIMULATING:
        return
    try:
        SIM = fake_drive.from_env(RIPDIR, album_dir_path, munge_fn=munge_filename)
    except fake_drive.SpecError as e:
        print(f"wtul-rip: {fake_drive.ENV_SPEC} is set but unusable: {e}",
              file=sys.stderr)
        print(f"Refusing to fall back to the real drive - unset "
              f"{fake_drive.ENV_SPEC} to rip for real.", file=sys.stderr)
        sys.exit(2)
    print(SIM.banner())


def rip_track(dev, discid, track, logfile):
    with open(logfile, "a") as lf:
        lf.write(f"\n=== track {track} ===\n")
    cmd = ["timeout", "--signal=TERM", "--kill-after=30s", str(PER_TRACK_TIMEOUT),
           "abcde", "-N", "-c", NOEJECT_CONF, "-d", dev, "-C", discid,
           "-a", "read,encode,tag,move", str(track)]
    rc, saw_error, urgent, pending, last_speed = sh_live(cmd, logfile)
    ok = rc == 0 and not saw_error
    if urgent:
        note = f"track {track} interrupted by '!{urgent}'"
    elif rc == 124:
        note = f"track {track} TIMED OUT after {PER_TRACK_TIMEOUT}s"
    elif not ok:
        note = f"track {track} failed (rc={rc})"
    else:
        note = f"track {track} ripped OK"
    with open(logfile, "a") as lf:
        lf.write(f"{note}\n")
    if ok and last_speed:
        print(f"    (read speed {last_speed:.1f}x)")
    return ok, note, urgent, pending


def rip_session(dev):
    """Returns True if the disc is fully ripped and can stop being retried,
    False if it should still be offered for retry (some tracks left)."""
    os.makedirs(LOGDIR, exist_ok=True)
    os.makedirs(RIPDIR, exist_ok=True)
    if free_kb(RIPDIR) < 524288:
        print(f"Only {free_kb(RIPDIR)}KB free at {RIPDIR}, refusing to start.")
        return True

    # Prune scratch dirs left behind by past sessions that were abandoned
    # (disc pulled, `q`'d out, or crashed) rather than finished or actively
    # being retried - a completed disc already removes its own tempdir, and
    # an in-progress retry is always recent, so anything old here is debris.
    now = time.time()
    for d in glob.glob(os.path.join(RIPDIR, "abcde.*")):
        if os.path.isdir(d) and now - os.path.getmtime(d) > STALE_TEMPDIR_SECS:
            shutil.rmtree(d, ignore_errors=True)

    stamp = time.strftime("%Y%m%dT%H%M%S")
    # SIMULATED goes in the filename, not just the body: history()'s recent-
    # sessions list shows basenames, so a rehearsal has to be unmistakable
    # there too rather than reading as a real rip that happened.
    suffix = "-SIMULATED" if SIM is not None else ""
    logfile = os.path.join(LOGDIR, f"{stamp}-{DEVNAME}{suffix}.log")

    print(f"Scraping metadata for {dev}...")
    rc, out = sh(["abcde", "-N", "-c", NOEJECT_CONF, "-d", dev, "-a", "cddb"], timeout=120)
    with open(logfile, "w") as lf:
        if SIM is not None:
            lf.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')}: SIMULATED REHEARSAL "
                      f"({fake_drive.ENV_SPEC} set) - no disc was read, "
                      f"not evidence of a real rip\n")
        lf.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')}: metadata scrape\n")
        lf.write(out)

    tempdir = newest_abcde_tempdir()
    if not tempdir:
        earcon()
        print("Could not find abcde's metadata scratch dir - aborting.")
        return True
    discid, artist, album, titles = parse_cddb_metadata(tempdir)
    toc_discid, toc_ntracks = read_toc_discid(tempdir)
    if not toc_discid:
        earcon()
        print("Metadata scrape failed to produce a discid - aborting.")
        return True
    if not discid:
        print("No CDDB/MusicBrainz match - ripping as Unknown Artist/Unknown "
              "Album. Fix live with artist=/album=/3=Real Title, or "
              f"'fix {toc_discid}' after.")
        artist, album = "Unknown Artist", ""
        titles = {n: f"Track {n}" for n in range(1, toc_ntracks + 1)}
    # abcde's own tempdir naming and the -C resume flag both key off the
    # TOC-based discid (cddbdiscid, e.g. "700a8608"), not whatever ID
    # scheme the winning metadata source used internally - MusicBrainz's
    # own DISCID field is a different (base64-ish) format, not the classic
    # CDDB hex id, and passing that to -C broke per-track resume (abcde
    # looked for a scratch dir keyed by the MusicBrainz id, found nothing,
    # "Discid undefined") whenever the match came from MusicBrainz rather
    # than plain CDDB. Live-verified 2026-07-24: this disc's CDDB lookup
    # returned no match ("none"), only MusicBrainz did, and that's exactly
    # when this broke.
    discid = toc_discid

    durations = track_durations(dev)
    track_nums = sorted(titles.keys()) or sorted(durations.keys())
    album_dir_guess = album_dir_path(artist, album, discid)
    already_done = existing_track_numbers(album_dir_guess)

    if not already_done:
        prior_dir = find_prior_rip(discid, exclude_dir=album_dir_guess)
        if prior_dir:
            linked = symlink_prior_rip(prior_dir, album_dir_guess)
            if linked:
                prior_date = os.path.basename(os.path.dirname(os.path.dirname(prior_dir)))
                print(f"Disc already ripped on {prior_date} ({prior_dir}) - "
                      f"symlinked {linked} track(s) instead of re-ripping.")
                already_done = existing_track_numbers(album_dir_guess)

    print(f"\nLooked up: {artist.strip()} - {album.strip()} ({len(track_nums)} tracks)")
    print_tracklist(track_nums, titles, durations, already_done)

    queue = [n for n in track_nums if n not in already_done]
    if not queue:
        write_discid_marker(album_dir_guess, discid)
        print("All tracks already ripped.")
        return True

    # Spinitron is informational only, not a gate - ripping starts at track 1
    # immediately regardless (2026-07-24: gating the whole rip on a match
    # turned out too restrictive live; smarter auto-detection, e.g. local
    # audio fingerprinting or a maintained-feed earcon, is future work, see
    # QUESTIONS.md - this is deliberately the simple version for now).
    try:
        spins = spinitron.fetch_recent_spins_public()
    except (urllib.error.URLError, OSError, ValueError) as e:
        print(f"Spinitron lookup failed ({e}), ripping full disc in track order.")
    else:
        matched = spinitron.matched_track_numbers(titles, artist, spins)
        if matched:
            print(f"Spinitron: {len(matched)} track(s) already played on air: "
                  f"{', '.join(str(n) for n in sorted(matched))} (informational only - "
                  f"type 'only {sorted(matched)[0]}' to rip just one of these)")

    print(f"Ripping now, starting with track {queue[0]}. While it's running you can type "
          f"(then Enter):")
    print("  5 2                 - reprioritize remaining tracks (rip 5, then 2, then the rest)")
    print("  only 5 7            - drop the rest of the queue, rip just these track(s)")
    print("  artist=Real Name    - fix the artist (retags any tracks already ripped too)")
    print("  album=Real Album    - fix the album (same)")
    print("  3=Real Track Title  - fix track 3's title (retags it if already ripped)")
    print("  q / !q              - stop after this track / stop this track right now (no eject)")
    print("  e / !e              - stop after this track / stop this track right now, then eject")
    print("  (Ctrl+C also interrupts immediately, any time)")
    print()

    results = []
    ripped = {}  # track number -> current mp3 path, for retroactive fixes
    control = None
    try:
        while queue:
            r, _, _ = select.select([sys.stdin], [], [], 0)
            if r:
                line = sys.stdin.readline()
                if line:
                    artist, album, titles, control = apply_live_input(
                        line, queue, tempdir, artist, album, titles, ripped, discid)
                    if control:
                        break
            n = queue.pop(0)
            print(f"  [{n}] {titles.get(n, f'Track {n}')} ...")
            ok, note, urgent, pending = rip_track(dev, discid, n, logfile)
            print(f"  [{n}] {titles.get(n, f'Track {n}'):40s} ... {'OK' if ok else 'FAILED'}")
            results.append((n, ok))
            if ok:
                path = find_track_file(album_dir_path(artist, album, discid), n)
                if path:
                    ripped[n] = path
            for pline in pending:
                artist, album, titles, c2 = apply_live_input(
                    pline, queue, tempdir, artist, album, titles, ripped, discid)
                control = control or c2
            if urgent:
                control = control or ("stop" if urgent == "q" else "eject")
            if control:
                break
    except KeyboardInterrupt:
        control = "stop"

    done = sum(1 for _, ok in results if ok)
    attempted = len(results)

    if control == "stop":
        print(f"\nStopped - {done}/{attempted} attempted tracks ripped, disc left in drive for retry.")
        with open(logfile, "a") as lf:
            lf.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')}: stopped by user, "
                      f"{done}/{attempted} attempted tracks ripped, disc left in drive\n")
        return False

    if control == "eject":
        print(f"\nStopping and ejecting - {done}/{attempted} attempted tracks ripped.")
        with open(logfile, "a") as lf:
            lf.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')}: user requested eject, "
                      f"{done}/{attempted} attempted tracks ripped, ejecting\n")
        sh(["eject", dev])
        print("Ejected.")
        return True

    ok_count = done
    all_ok = ok_count == attempted
    with open(logfile, "a") as lf:
        lf.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')}: session finished - "
                  f"{ok_count}/{attempted} tracks ripped"
                  f"{', ejecting' if all_ok else ', disc left in drive for retry'}\n")

    print(f"\n{ok_count}/{attempted} tracks ripped.")
    if all_ok:
        write_discid_marker(album_dir_path(artist, album, discid), discid)
        sh(["eject", dev])
        shutil.rmtree(tempdir, ignore_errors=True)
        print("All tracks ripped - disc ejected.")
        # Sandboxing RIPDIR is not enough on its own: this write-back is a
        # POST to the real rotation-catalog sheet, so an otherwise contained
        # rehearsal would still put a fake album in the station's live
        # catalog - and #8 deliberately built no delete endpoint, so that row
        # then has to come out by hand. Found exactly this way, by running a
        # rehearsal for real on 2026-07-25 (it did log one junk row before
        # this guard existed). Read-only lookups (Spinitron scrape, Discogs,
        # AcoustID) are left alone - they change nothing outside this machine.
        # The opt-in exists only so the rehearsal suite can still cover the
        # "complete disc logs a row / partial disc does not" rule (it injects
        # a fake write_row); it is never set in normal use.
        if SIM is not None and not SIMULATE_ALLOW_CATALOG:
            print("Catalog: write-back SUPPRESSED (rehearsal) - a simulated "
                  "disc must never enter the real rotation catalog.")
        elif CATALOG_WRITEBACK_URL:
            confirmed = catalog_writeback.write_row(CATALOG_WRITEBACK_URL, {
                "ARTIST": artist.strip(),
                "ALBUM": album.strip(),
                "DATE": time.strftime("%Y-%m-%d"),
                "LOCAL": True,
            })
            if confirmed:
                print("Catalog: logged to sheet.")
            else:
                print("Catalog: write-back failed or unreachable, not logged - "
                      "add it to the sheet by hand if it matters.")
        tracklist = [titles.get(n, f"Track {n}") for n in track_nums]
        # Rendering stays: it's pure PIL, so a rehearsal exercises the label
        # layout for free. Only the print itself is gated - catprint talks to
        # the real M02 over BLE, and a simulated disc must not spend real
        # label tape (same containment rule as the catalog write-back above;
        # this gap appeared when label printing merged to main under the
        # harness, caught by running a rehearsal for real on 2026-07-25).
        label = label_render.render_label(artist.strip(), album.strip(),
                                           tracklist=tracklist, discid=discid)
        if SIM is not None:
            print("Label: print SUPPRESSED (rehearsal) - a simulated disc "
                  "never spends real label tape.")
        else:
            printed, reason = label_render.print_label(label)
            if printed:
                print("Label: printed.")
            else:
                print(f"Label: not printed ({reason}) - printer may be off/out of range, "
                      "not a rip failure.")
        if PHOTO_CAPTURE_URL:
            # Same containment rule as the catalog write-back and label print
            # above: a rehearsal must not invite a real phone upload against
            # the real GAS endpoint for a disc that doesn't exist.
            if SIM is not None:
                print("Photo capture: pairing SUPPRESSED (rehearsal) - a "
                      "simulated disc never pairs against the real endpoint.")
            else:
                pairing_code = photo_capture.new_pairing_code()
                url = photo_capture.pairing_url(PHOTO_CAPTURE_URL, pairing_code, discid)
                print(f"Photo capture: open {url} on a phone to attach cover art "
                      f"(code {pairing_code}), then run 'photos' later to pull it down.")
                _record_pending_photo(pairing_code, discid, album_dir_path(artist, album, discid),
                                       list(ripped.values()), artist.strip(), album.strip())
        return True
    else:
        print("Some tracks failed.")
        return False


def _load_pending_photos():
    """Pairing codes issued by past rip sessions whose phone upload hasn't
    been pulled down yet - a plain JSON list, not a database, since it's
    small and only this process touches it. Missing/corrupt file reads
    as empty rather than raising, same non-fatal discipline as the rest
    of the photo-capture integration (ROADMAP #4)."""
    if not os.path.isfile(PENDING_PHOTOS_FILE):
        return []
    try:
        with open(PENDING_PHOTOS_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return []


def _save_pending_photos(items):
    os.makedirs(os.path.dirname(PENDING_PHOTOS_FILE), exist_ok=True)
    with open(PENDING_PHOTOS_FILE, "w") as f:
        json.dump(items, f, indent=2)


def _record_pending_photo(pairing_code, discid, album_dir, mp3s, artist, album):
    pending = _load_pending_photos()
    pending.append({
        "pairing_code": pairing_code,
        "disc_id": discid,
        "dir": album_dir,
        "mp3s": mp3s,
        "artist": artist,
        "album": album,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
    })
    _save_pending_photos(pending)


def check_pending_photos():
    """Single non-blocking poll of every pending pairing (see 'photos' in
    the interactive menu) - not a wait, since this runs inline in the
    same loop as disc-insert polling and must never hang it. A pairing
    whose photo hasn't landed yet is just left pending for the next
    check."""
    if not PHOTO_CAPTURE_URL:
        print("PHOTO_CAPTURE_URL not set - nothing to check.")
        return
    pending = _load_pending_photos()
    if not pending:
        print("No pending photo pairings.")
        return
    still_pending = []
    for rec in pending:
        result = photo_capture.check_photo(PHOTO_CAPTURE_URL, rec["pairing_code"])
        label = f"{rec.get('artist', '?')} - {rec.get('album', '?')}"
        if result and result.get("found"):
            image_path = os.path.join(rec["dir"], "cover.jpg")
            if photo_capture.download_image(result["url"], image_path):
                ok, failed = photo_capture.embed_album_art(image_path, rec["mp3s"])
                print(f"{label}: photo embedded on {len(ok)}/{len(rec['mp3s'])} track(s)"
                      + (f", {len(failed)} failed" if failed else "") + ".")
            else:
                print(f"{label}: photo found but download failed, will retry.")
                still_pending.append(rec)
        else:
            still_pending.append(rec)
    _save_pending_photos(still_pending)
    if still_pending:
        print(f"{len(still_pending)}/{len(pending)} pairing(s) still waiting on a phone upload.")


def parse_rip_speeds(text):
    """Parse one rip-session log's text into per-track speed records.

    Pure text -> list of dicts, one per "=== track N ===" section, each:
      track      - track number (int)
      final      - last non-zero extraction-speed multiplier seen (float or None)
      peak       - highest multiplier seen (float or None)
      samples    - how many progress samples were seen
      size_mb    - finished mp3 size in MB (float or None)
      status     - 'ok' | 'failed' | 'timeout' | 'interrupted' | 'unknown'

    Everything is recovered from the raw log lines abcde/cdparanoia already
    write, so this works retroactively on any log ever produced - no separate
    stats store to keep in sync. A section with no note line (e.g. the log was
    truncated mid-rip) is reported as 'unknown' rather than dropped.
    """
    records = []
    cur = None

    def flush():
        if cur is not None:
            records.append(cur)

    for line in text.splitlines():
        m = TRACK_MARK_RE.match(line)
        if m:
            flush()
            cur = {"track": int(m.group(1)), "final": None, "peak": None,
                   "samples": 0, "size_mb": None, "status": "unknown"}
            continue
        if cur is None:
            continue
        for sm in SPEED_RE.finditer(line):
            val = float(sm.group(1))
            cur["samples"] += 1
            if val > 0:
                cur["final"] = val
                if cur["peak"] is None or val > cur["peak"]:
                    cur["peak"] = val
        zm = SIZE_RE.search(line)
        if zm:
            cur["size_mb"] = float(zm.group(1))
        nm = NOTE_RE.match(line)
        if nm and nm.group(1) == str(cur["track"]):
            cur["status"] = NOTE_STATUS.get(nm.group(2), "unknown")
    flush()
    return records


def _median(vals):
    s = sorted(vals)
    n = len(s)
    if n == 0:
        return None
    mid = n // 2
    return s[mid] if n % 2 else (s[mid - 1] + s[mid]) / 2


def format_speed_report(sessions):
    """sessions: list of (name, records) in chronological order. Returns a
    printable multi-line string summarizing extraction speed per session,
    the overall median, and any tracks that ripped notably slow."""
    ok_speeds = [r["final"] for _, recs in sessions for r in recs
                 if r["status"] == "ok" and r["final"] is not None]
    if not ok_speeds:
        return "No extraction-speed data found in the rip logs yet."

    overall = _median(ok_speeds)
    slow_cut = overall * SLOW_SPEED_FRACTION
    out = ["=== Rip extraction speed ==="]
    out.append(f"{len(ok_speeds)} tracks with speed data across {len(sessions)} session(s); "
               f"overall median {overall:.1f}x (min {min(ok_speeds):.1f}x, max {max(ok_speeds):.1f}x)")

    slow = []
    session_medians = []
    for name, recs in sessions:
        speeds = [r["final"] for r in recs if r["status"] == "ok" and r["final"] is not None]
        if not speeds:
            continue
        med = _median(speeds)
        session_medians.append((name, med))
        out.append(f"  {name}: {len(speeds)} track(s), median {med:.1f}x "
                   f"(min {min(speeds):.1f}x)")
        for r in recs:
            if r["status"] == "ok" and r["final"] is not None and r["final"] < slow_cut:
                slow.append((name, r["track"], r["final"]))

    if slow:
        out.append("")
        out.append(f"Slow tracks (< {SLOW_SPEED_FRACTION:.0%} of median = {slow_cut:.1f}x):")
        for name, track, sp in slow:
            out.append(f"  {name} track {track}: {sp:.1f}x")

    # Degradation hint: is the most recent session meaningfully slower than
    # the historical median of earlier sessions? Only claim it with >=2 sessions.
    if len(session_medians) >= 2:
        recent_name, recent_med = session_medians[-1]
        earlier = [m for _, m in session_medians[:-1]]
        base = _median(earlier)
        if base and recent_med < base * SLOW_SPEED_FRACTION:
            out.append("")
            out.append(f"NOTE: newest session ({recent_name}) median {recent_med:.1f}x is well "
                       f"below the earlier-session median {base:.1f}x - possible drive/media "
                       f"degradation worth a hardware check.")
    return "\n".join(out)


def load_speed_sessions(*logdirs):
    """Read every rip log under the given dir(s), parse each, and return
    [(name, records), ...] sorted chronologically by file mtime across all
    of them - so pre-migration sessions (LEGACY_LOGDIR) and current ones
    (LOGDIR) interleave in real order rather than per-directory."""
    paths = []
    for logdir in logdirs:
        paths.extend(glob.glob(os.path.join(logdir, "*.log")))
    sessions = []
    for path in sorted(paths, key=os.path.getmtime):
        try:
            with open(path, "r", errors="replace") as f:
                text = f.read()
        except OSError:
            continue
        recs = parse_rip_speeds(text)
        if recs:
            sessions.append((os.path.basename(path), recs))
    return sessions


def speed_report():
    logdirs = [d for d in (LEGACY_LOGDIR, LOGDIR) if os.path.isdir(d)]
    if not logdirs:
        print("No rip logs yet - nothing to report on.")
        return
    sessions = load_speed_sessions(*logdirs)
    print()
    print(format_speed_report(sessions))
    print()


def history():
    try:
        from mutagen.easyid3 import EasyID3
        from mutagen.mp3 import MP3
    except ImportError:
        print("mutagen not available - can't read tags for history view.")
        return

    albums = {}
    for root, dirs, files in os.walk(MIXES_ROOT):
        dirs[:] = [d for d in dirs if d != ".logs" and not d.startswith("abcde.")]
        for name in files:
            if not name.lower().endswith(".mp3"):
                continue
            path = os.path.join(root, name)
            try:
                tags = EasyID3(path)
            except Exception:
                continue
            artist = (tags.get("artist") or ["Unknown Artist"])[0]
            album = (tags.get("album") or ["Unknown Album"])[0]
            title = (tags.get("title") or [name])[0]
            track = (tags.get("tracknumber") or ["0"])[0].split("/")[0]
            try:
                track = int(track)
            except ValueError:
                track = 0
            mtime = os.path.getmtime(path)
            albums.setdefault((artist, album), []).append((track, title, mtime))

    if albums:
        print("\n=== Ripped albums ===")
        for (artist, album), tracks in sorted(albums.items(), key=lambda kv: -max(t[2] for t in kv[1])):
            tracks.sort()
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(max(t[2] for t in tracks)))
            print(f"\n{artist} - {album}  ({len(tracks)} tracks, last ripped {when})")
            for track, title, _ in tracks:
                print(f"    {track:2d}. {title}")
    else:
        print("\nNo ripped albums found yet.")

    if os.path.isdir(LOGDIR):
        logs = sorted(glob.glob(os.path.join(LOGDIR, "*.log")), key=os.path.getmtime, reverse=True)[:8]
        if logs:
            print("\n=== Recent rip sessions ===")
            for path in logs:
                with open(path, "r", errors="replace") as f:
                    lines = [l.strip() for l in f if l.strip()]
                summary = lines[-1] if lines else "(empty)"
                print(f"  {os.path.basename(path)}: {summary}")


def status():
    props = udev_props(DEV)
    present = props.get("ID_CDROM_MEDIA") == "1"
    tracks = props.get("ID_CDROM_MEDIA_TRACK_COUNT_AUDIO", "0")
    print(f"\nDevice: {DEV}")
    print(f"Disc present: {'yes' if present else 'no'}" + (f" ({tracks} audio tracks)" if present else ""))
    busy = os.path.exists(LOCKFILE) and not Lock(LOCKFILE).acquire()
    print(f"Rip in progress: {'yes' if busy else 'no'}")


def _spin_key(spin):
    return (spin.get("artist", ""), spin.get("song", ""))


def _format_spin(spin):
    artist = spin.get("artist") or "?"
    song = spin.get("song") or "?"
    return f"{artist} - {song}"


def check_for_new_spins(seen_spin_keys, quiet_errors=True):
    """Fetch the current Spinitron public page and print any spin not in
    seen_spin_keys yet (so the on-air signal #1 already computes per-rip is
    also visible live while wtul-rip idles between discs, not just baked
    into the queue order at rip time).

    Returns the updated seen_spin_keys set (unchanged on a fetch failure -
    same best-effort/never-abort posture rip_session()'s own Spinitron call
    already has). seen_spin_keys=None means "first check" - it seeds the
    set silently instead of printing the station's whole current-show
    history as if it just happened.
    """
    try:
        spins = spinitron.fetch_recent_spins_public()
    except (urllib.error.URLError, ValueError, OSError) as e:
        if not quiet_errors:
            print(f"  (spin check failed: {e})")
        return seen_spin_keys
    keys = {_spin_key(s) for s in spins if s.get("artist") or s.get("song")}
    if seen_spin_keys is not None:
        new_keys = keys - seen_spin_keys
        if new_keys:
            for s in spins:
                if _spin_key(s) in new_keys:
                    print(f"  ♫ on air: {_format_spin(s)}")
    return keys


def main():
    print(f"wtul-rip watching {DEV}. Press 'h' for history, 's' for status, "
          f"'e' to eject, 'spins' to check Spinitron now, 'speed' for "
          f"rip-speed stats, 'photos' to check for pending phone photo "
          f"uploads, 'fix <discid>' to relabel a past disc, 'q' to quit.\n")
    last_seen_empty = True
    seen_spin_keys = None
    last_spin_check = 0.0
    # Once stdin hits EOF it stays readable forever, and select() returns
    # immediately every time - so watching it would spin this loop at 100%
    # CPU instead of polling the drive every POLL_SECS. That's what happens
    # to anyone who runs wtul-rip with stdin redirected (`</dev/null`,
    # nohup, a wrapper script, a rehearsal driven from a batch job) rather
    # than from a terminal. Dropping stdin from the select set keeps the
    # drive-watching half working headless; the interactive commands are
    # simply unavailable, which is already true of a closed stdin.
    watch_stdin = True
    while True:
        r = []
        if watch_stdin:
            r, _, _ = select.select([sys.stdin], [], [], POLL_SECS)
        else:
            time.sleep(POLL_SECS)
        if r:
            raw = sys.stdin.readline()
            if raw == "":
                print("(stdin closed - still watching the drive, but keyboard "
                      "commands are off for the rest of this run.)")
                watch_stdin = False
                continue
            cmd = raw.strip()
            low = cmd.lower()
            if low in ("q", "!q"):
                return
            elif low == "h":
                history()
            elif low == "s":
                status()
            elif low == "e":
                sh(["eject", DEV])
                print(f"Ejected {DEV}.")
                last_seen_empty = True
            elif low == "spins":
                last_spin_check = time.time()
                seen_spin_keys = check_for_new_spins(seen_spin_keys, quiet_errors=False)
                if seen_spin_keys is not None and not seen_spin_keys:
                    print("  (no spins found on the public page yet)")
            elif low == "photos":
                check_pending_photos()
            elif low == "speed":
                speed_report()
            elif low.startswith("fix "):
                fix_by_discid(cmd.split(None, 1)[1].strip())
            continue

        # Best-effort live "already played on air" signal while idling
        # between discs - same source rip_session() checks once per disc,
        # just surfaced continuously instead of only at rip-queue-build
        # time. Never raises; a scrape failure just skips this tick.
        now = time.time()
        if now - last_spin_check >= SPIN_POLL_SECS:
            last_spin_check = now
            seen_spin_keys = check_for_new_spins(seen_spin_keys)

        n = disc_audio_track_count(DEV)
        if n <= 0:
            last_seen_empty = True
            continue
        if not last_seen_empty:
            continue
        last_seen_empty = False

        lock = Lock(LOCKFILE)
        if not lock.acquire():
            print("Another rip is already in progress on this device, skipping.")
            continue
        try:
            done = rip_session(DEV)
            # A disc that didn't fully rip stays in the drive - keep offering
            # to retry the remaining tracks rather than silently ignoring it
            # (which is what would happen if we just went back to polling,
            # since the disc never leaves and never re-triggers).
            while not done:
                try:
                    choice = input(
                        "\nDisc left in drive. Press Enter to retry (e.g. to "
                        "recheck Spinitron), 'e' to eject, or 'q' to give up "
                        "on this disc: "
                    ).strip().lower()
                except EOFError:
                    # Same headless case as the select() loop above: there is
                    # nobody to answer the prompt. Give up on this disc and go
                    # back to watching, rather than dying on a traceback with
                    # a half-ripped disc still in the drive.
                    print("\n(stdin closed - leaving the disc in the drive, "
                          "not retrying.)")
                    break
                if choice == "q":
                    break
                if choice == "e":
                    sh(["eject", DEV])
                    print(f"Ejected {DEV}.")
                    break
                done = rip_session(DEV)
        except KeyboardInterrupt:
            print()
        finally:
            lock.release()
        print(f"\nwatching {DEV}. Press 'h' for history, 's' for status, "
              f"'speed' for rip-speed stats, 'q' to quit.\n")


if __name__ == "__main__":
    # `wtul-rip speed` prints the extraction-speed report from past logs and
    # exits - a read-only view that needs no drive, disc, or watch loop.
    if len(sys.argv) > 1 and sys.argv[1] == "speed":
        speed_report()
        sys.exit(0)
    try:
        init_simulation()
        main()
    except KeyboardInterrupt:
        print()
