#!/usr/bin/env bash
# grave -- engrave the disc: rip, tag and log a radio record
#
# A plain shell utility. It costs nothing to run and reaches no paid service
# except where a subcommand explicitly declares a summon.
#
# The subcommand table below was DISCOVERED from tooling that actually exists
# in this tree, not invented. A subcommand backed by a script execs it. One
# the contract names but has nothing behind it reports GAP (exit 4) rather
# than pretending, because an exit-0 no-op is the worst failure available.

SELF="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

VERB_NAME=grave
VERB_SUMMARY="engrave the disc: rip, tag and log a radio record"
VERB_USAGE="grave <subcommand> [args...]"
VERB_CAN_SUMMON=0
# shellcheck source=../lib/verb.sh
. "$SELF/lib/verb.sh"

# Where the legacy implementation lives, for subcommands that exec it. Read
# from ONE place; never retyped per subcommand.
LEGACY_ROOT="${GRAVE_LEGACY_ROOT:-/home/zach/Documents/wtul}"

verb_subcommands() {
  printf '%s\n' \
    'cd-autorip                   run bin/cd-autorip.sh' \
    'wtul-rip                     run bin/wtul-rip' \
    'install                      run install.sh' \
    'install-tesseract-local      run scripts/install-tesseract-local.sh' \
    ''
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
verb_parse "$@"
set -- "${VERB_ARGS[@]+"${VERB_ARGS[@]}"}"

case "$cmd" in
  ''|list)
    printf '%s -- %s\n\n' "$VERB_NAME" "$VERB_SUMMARY"
    printf 'subcommands (discovered from real tooling):\n'
    verb_subcommands | sed '/^$/d' | sed 's/^/  /'
    printf '\n(`%s --help` for flags, `man %s` for the contract)\n' "$VERB_NAME" "$VERB_NAME"
    ;;
  help|--help|-h) verb_usage ;;
  cd-autorip)
    [ -x "$LEGACY_ROOT/bin/cd-autorip.sh" ] || verb_gap 'cd-autorip: bin/cd-autorip.sh is not executable or not present'
    exec "$LEGACY_ROOT/bin/cd-autorip.sh" "$@" ;;
  wtul-rip)
    [ -x "$LEGACY_ROOT/bin/wtul-rip" ] || verb_gap 'wtul-rip: bin/wtul-rip is not executable or not present'
    exec "$LEGACY_ROOT/bin/wtul-rip" "$@" ;;
  install)
    [ -x "$LEGACY_ROOT/install.sh" ] || verb_gap 'install: install.sh is not executable or not present'
    exec "$LEGACY_ROOT/install.sh" "$@" ;;
  install-tesseract-local)
    [ -x "$LEGACY_ROOT/scripts/install-tesseract-local.sh" ] || verb_gap 'install-tesseract-local: scripts/install-tesseract-local.sh is not executable or not present'
    exec "$LEGACY_ROOT/scripts/install-tesseract-local.sh" "$@" ;;
  *) verb_die "unknown subcommand: $cmd  (try: $VERB_NAME list)" ;;
esac
